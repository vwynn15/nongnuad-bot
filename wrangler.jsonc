{
  "name": "nongnuad-bot",
  "main": "src/index.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "expense-bot-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RECEIPTS",
      "bucket_name": "expense-bot-receipts"
    }
  ],
  "vars": {
    "LIFF_ID": "REPLACE_WITH_YOUR_LIFF_ID"
  }
}
